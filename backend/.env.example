# Waggle Recover — Environment Configuration
# Copy to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Waggle Recover"
DEBUG=false

# ── Databases ────────────────────────────────────────────────────────────────
APP_DB_PATH=./data/waggle_recover.db
WAGGLE_DB_PATH=./data/waggle_memory.db

# ── Waggle Memory ─────────────────────────────────────────────────────────────
WAGGLE_TENANT_ID=waggle-recover
WAGGLE_EMBEDDING_MODEL=all-MiniLM-L6-v2
WAGGLE_ENABLE_DEDUP=false

# ── Razorpay (optional — leave blank for simulator mode) ─────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENABLED=false

# ── Decision Engine ───────────────────────────────────────────────────────────
# Options: deterministic | llm | agent
DECISION_PROVIDER=deterministic

# LLM settings (only used when DECISION_PROVIDER=llm)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Constrained AI Agent (only used when DECISION_PROVIDER=agent or the simulator
# AI Agent toggle is selected). Model remains runtime-configurable. This example
# was listed by Groq when this file was updated; check Groq's current model list.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AGENT_TEMPERATURE=0.0
AGENT_TIMEOUT_SECONDS=15

# Pre-registered online strategy-adaptation constants. Do not tune against evaluation results.
STRATEGY_PRIOR_KAPPA=5.0
STRATEGY_MIN_EFFECTIVE_N=5.0

# ── Recovery Policy ───────────────────────────────────────────────────────────
LOOKUP_FIRST_CONFIDENCE_THRESHOLD=0.75
MAX_EVIDENCE_NODES=20
EVIDENCE_RECENCY_HALF_LIFE_DAYS=14.0
# Enable these together for any publicly reachable deployment. They protect
# destructive reset and resource-intensive evaluation mutation endpoints.
PROTECT_MUTATION_ENDPOINTS=false
MUTATION_API_TOKEN=
